{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "paths": {
      "@/*": ["./src/*"],
      "@career-bridge/types": ["./packages/types/src"],
      "@career-bridge/types/*": ["./packages/types/src/*"],
      "@career-bridge/ui": ["./packages/ui/src"],
      "@career-bridge/ui/*": ["./packages/ui/src/*"],
      "@career-bridge/store": ["./packages/store/src"],
      "@career-bridge/store/*": ["./packages/store/src/*"],
      "@career-bridge/services": ["./packages/services/src"],
      "@career-bridge/services/*": ["./packages/services/src/*"],
      "@career-bridge/utils": ["./packages/utils/src"],
      "@career-bridge/utils/*": ["./packages/utils/src/*"],
      "@career-bridge/ai": ["./packages/ai/src"],
      "@career-bridge/ai/*": ["./packages/ai/src/*"],
      "@career-bridge/config": ["./packages/config/src"],
      "@career-bridge/config/*": ["./packages/config/src/*"],
      "@career-bridge/realtime": ["./packages/realtime/src"],
      "@career-bridge/realtime/*": ["./packages/realtime/src/*"]
    },
    "plugins": [{ "name": "next" }]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
