{
  "name": "@career-bridge/gateway",
  "version": "1.0.0",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prestart": "tsc",
    "test": "vitest run src",
    "db:migrate:assessment": "tsx src/modules/assessment/migrator.ts",
    "db:import:assessment": "tsx src/modules/assessment/importer.ts",
    "db:verify:assessment": "tsx src/modules/assessment/verifier.ts"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "groq-sdk": "^1.2.0",
    "helmet": "^7.1.0",
    "ioredis": "^6.0.0",
    "mysql2": "^3.24.6",
    "openai": "^6.37.0",
    "socket.io": "^4.6.1",
    "typescript": "^5.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/ioredis": "^5.0.0",
    "@types/node": "^22.20.5",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.4"
  }
}
