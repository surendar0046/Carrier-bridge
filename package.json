{
  "name": "career-bridge",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "node -e \"const fs = require('fs'); if (fs.existsSync('backend/gateway/dist') && !fs.existsSync('dist')) fs.cpSync('backend/gateway/dist', 'dist', {recursive: true}); console.log('Deployment build verified');\"",
    "start": "node dist/server.js",
    "build:tsc": "turbo run build",
    "build:all": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:migrate:assessment": "pnpm --filter @career-bridge/gateway db:migrate:assessment",
    "db:import:assessment": "pnpm --filter @career-bridge/gateway db:import:assessment",
    "db:verify:assessment": "pnpm --filter @career-bridge/gateway db:verify:assessment",
    "test:assessment": "pnpm --filter @career-bridge/gateway test"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "groq-sdk": "^1.2.0",
    "helmet": "^7.1.0",
    "ioredis": "^6.0.0",
    "mysql2": "^3.24.6",
    "openai": "^6.37.0",
    "socket.io": "^4.6.1",
    "typescript": "^5.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "turbo": "latest",
    "prettier": "latest"
  },
  "packageManager": "pnpm@9.0.0"
}
