{
  "name": "career-bridge",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npm --prefix backend/gateway install --ignore-scripts && npm --prefix backend/gateway run build",
    "start": "node backend/gateway/dist/server.js",
    "build:all": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:migrate:assessment": "pnpm --filter @career-bridge/gateway db:migrate:assessment",
    "db:import:assessment": "pnpm --filter @career-bridge/gateway db:import:assessment",
    "db:verify:assessment": "pnpm --filter @career-bridge/gateway db:verify:assessment",
    "test:assessment": "pnpm --filter @career-bridge/gateway test"
  },
  "devDependencies": {
    "turbo": "latest",
    "prettier": "latest"
  },
  "packageManager": "pnpm@9.0.0"
}
